# MetalDetect frontend configuration.
#
# BOTH VARIABLES ARE OPTIONAL. Leave them unset (the default) and the app runs
# in DEMO MODE: the built-in simulated data layer under /api serves everything,
# so a bare Vercel deployment works with zero configuration.
#
# Set them to point the dashboard at a running FastAPI backend instead — then
# it uses the trained scikit-learn models and the live WebSocket feed.
#
# Copy to `.env.local` for local overrides. Never commit real .env files.

# Base URL of the FastAPI backend (REST). Unset = built-in demo data layer.
# Example: https://metaldetect-api.onrender.com
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# WebSocket URL of the backend live feed. Optional — when NEXT_PUBLIC_API_BASE
# is set this is derived automatically (http->ws, https->wss, + /live).
# Must be wss:// when the site is served over https.
# Example: wss://metaldetect-api.onrender.com/live
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/live

# Note: no weather API key is needed anywhere. Weather comes from Open-Meteo,
# a free, open-source, key-free API (https://open-meteo.com).
